# SelfShare 仓库忽略规则

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/

# Rust
desktop/core/target/
desktop/core/Cargo.lock.bak

# Flutter / Dart
desktop/app/build/
desktop/app/.dart_tool/
desktop/app/.flutter-plugins
desktop/app/.flutter-plugins-dependencies
# pubspec.lock 建议入库以保证可复现构建：不忽略
desktop/app/windows/flutter/ephemeral/
# 注意：windows/flutter/*.cmake 与 generated_plugin_registrant 必须入库，
# 否则 CI 上 flutter build 会因为找不到 CMakeLists.txt 直接失败。

# 构建产物
desktop/app/rust/selfshare_core.dll
desktop/core/target/

# 同步运行数据（绝不入库）
.selfshare/
selfshare-data/
*.selfshare-tmp

# 平台
Thumbs.db
.DS_Store
desktop.ini

# 测试/QA 临时
tests/__pycache__/
*.log

# 敏感配置（令牌、密钥）
*.pem
*.key
.env
server.env

# 开发缓存
.box-agent-scratch/
.vs/
.idea/
